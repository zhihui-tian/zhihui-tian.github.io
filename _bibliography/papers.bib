@article{tian2026scaling,
  abbr        = {Acta Mat.},
  bibtex_show = {true},
  selected    = {true},
  title       = {Scaling kinetic {Monte-Carlo} simulations of grain growth with combined convolutional and graph neural networks},
  author      = {Tian, Zhihui and Suwandi, Ethan and Oppelstrup, Tomas and Bulatov, Vasily V. and Harley, Joel B. and Zhou, Fei},
  journal     = {Acta Materialia},
  volume      = {311},
  pages       = {122153},
  year        = {2026},
  publisher   = {Elsevier},
  doi         = {10.1016/j.actamat.2026.122153},
  html        = {https://doi.org/10.1016/j.actamat.2026.122153},
  arxiv       = {2511.17848},
  abstract    = {Graph neural networks (GNN) have emerged as a promising machine learning method for microstructure simulations such as grain growth, but accurate modeling of realistic grain boundary networks requires large simulation cells, which GNN has difficulty scaling up to. We propose a hybrid architecture combining a CNN-based bijective autoencoder that compresses the spatial dimensions with a GNN that evolves the microstructure in the reduced latent space, achieving up to 117x memory reduction and 115x runtime improvement on 3D meshes up to 160^3 relative to a GNN-only baseline.}
}

